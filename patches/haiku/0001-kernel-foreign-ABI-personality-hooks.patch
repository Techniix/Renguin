@@ -58,6 +58,7 @@
 #include <vfs.h>
 #include <vm/vm.h>
 #include <vm/VMAddressSpace.h>
+#include <foreign_personality.h>
 #include <util/AutoLock.h>
 #include <util/ThreadAutoLock.h>
 
@@ -474,6 +475,9 @@ Team::Team(team_id id, bool kernel)
 
 	commpage_address = NULL;
 
